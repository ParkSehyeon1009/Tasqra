# app/core/config.py의 Settings 필드와 짝을 맞춰서 채우세요.
API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tasqra
JWT_SECRET_KEY=change-this-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=14
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tasqra

# USE_FAKE_AI는 반드시 기본값 true로 둘 것 — 개발 중 실수로 실제 API 비용이
# 발생하는 것을 막는 안전장치입니다 (app/dependencies.py 참고).
USE_FAKE_AI=true
# USE_FAKE_AI=false일 때 어느 제공자를 쓸지 고릅니다: openai | local
#   local = Ollama 등 OpenAI 호환 로컬 서버 (호출 비용 없음)
AI_PROVIDER=openai
# AI_PROVIDER=local일 때만 사용합니다.
#   venv 직접 실행:   http://localhost:11434/v1
#   도커 컨테이너 안: http://host.docker.internal:11434/v1
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
# 로컬 소형 모델은 컨텍스트 창이 좁아(Ollama 기본 num_ctx=2048) 긴 문서를
# 조용히 잘라먹으므로, 프롬프트에 넣을 텍스트 길이를 미리 제한합니다.
AI_MAX_INPUT_CHARS=6000

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
MAX_PAGES=30
MAX_EXTRACTED_CHARS=45000

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

ENVIRONMENT=development
