# app/core/config.py의 Settings 필드와 짝을 맞춰서 채우세요.
API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tasqra
JWT_SECRET_KEY=change-this-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=14
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tasqra

# USE_FAKE_AI는 반드시 기본값 true로 둘 것 — 개발 중 실수로 실제 API 비용이
# 발생하는 것을 막는 안전장치입니다 (app/dependencies.py 참고).
USE_FAKE_AI=true
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
MAX_PAGES=30
MAX_EXTRACTED_CHARS=45000

ENVIRONMENT=development
