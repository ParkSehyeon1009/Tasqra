# app/core/config.py의 Settings 필드와 짝을 맞춰서 채우세요.
API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tasqra
JWT_SECRET_KEY=change-this-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=14
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tasqra

# USE_FAKE_AI는 반드시 기본값 true로 둘 것 — 개발 중 실수로 실제 API 비용이
# 발생하는 것을 막는 안전장치입니다 (app/dependencies.py 참고).
USE_FAKE_AI=true
# USE_FAKE_AI=false일 때 어느 제공자를 쓸지 고릅니다: openai | local
#   local = Ollama 등 OpenAI 호환 로컬 서버 (호출 비용 없음)
AI_PROVIDER=openai
# AI_PROVIDER=local일 때만 사용합니다.
#   venv 직접 실행:   http://localhost:11434/v1
#   도커 컨테이너 안: http://host.docker.internal:11434/v1
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
# 원문 1구간의 문자 상한. 요약은 초과분을 버리지 않고 모든 구간을 처리합니다.
AI_MAX_INPUT_CHARS=6000
# 서버의 실제 컨텍스트 크기와 일치시켜야 합니다. 이 값이 서버 설정을 변경하지는 않습니다.
AI_CONTEXT_TOKENS=8192
AI_MAX_OUTPUT_TOKENS=1536
AI_CHUNK_OVERLAP_CHARS=160
AI_MAX_CHUNKS=256
AI_CHUNK_RETRIES=1
# 대기 시간을 포함한 분석 작업 전체 상한(초)
AI_ANALYSIS_TIMEOUT_SECONDS=1800

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
MAX_PAGES=30
MAX_EXTRACTED_CHARS=45000
OCR_TEXT_DET_MAX_SIDE_LEN=2500

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

ENVIRONMENT=development

# --- 임베딩 (의미 검색) ------------------------------------------------------
# 기본은 가짜 벡터다. 개발 중 모델이 메모리를 잡는 것을 막는 안전장치다.
# 실제 검색을 쓰려면 false 로 바꾼다.
USE_FAKE_EMBEDDING=true

# false 일 때 어떤 구현을 쓸지.
#   local-model : 컨테이너 안에서 모델을 직접 로드 (서버 불필요, 메모리 약 1.2GB)
#   local-http  : OpenAI 호환 /v1/embeddings 서버 호출 (컨테이너 메모리 0)
#
# ✅ 결정 (2026-08-24, SYS-002-4) — **local-model 을 표준 경로로 한다.**
#   시연은 녹화본으로 하고 녹화는 GPU 가 있는 PC 에서 한다. 그 조건에서는 서버를
#   따로 띄우지 않는 쪽이 단계가 적고, 어댑터가 저장소에 있어 받아 올 것도 없다.
#   local-http 는 컨테이너 메모리를 아껴야 할 때만 쓰는 예외 경로다.
#
# ⚠️ 경로를 바꾸면 **색인을 다시 해야 한다.** 기록되는 모델 이름이 다르다.
#     local-model -> "dragonkue/BGE-m3-ko+embedding-hn-v1"  (어댑터 이름이 붙는다)
#     local-http  -> "dragonkue/BGE-m3-ko"                  (EMBEDDING_MODEL 값 그대로)
#   검색은 WHERE embedding_model = 지금 쓰는 모델 로 걸린다. 그래서 한 경로로
#   색인한 뒤 다른 경로로 검색하면 **에러 없이 0건**이다. 검색이 0건이면 이것부터
#   본다:
#     SELECT embedding_model, count(*) FROM document_chunks GROUP BY 1;
EMBEDDING_PROVIDER=local-model

# 베이스 모델. 첫 실행 때 HF 에서 받아 캐시된다(약 2.2GB, hf_cache 볼륨).
EMBEDDING_BASE_MODEL=dragonkue/BGE-m3-ko
# 공공 SI 문서로 파인튜닝한 LoRA 어댑터. 저장소에 들어 있다(27MB).
# 비우면 검색 품질이 크게 떨어진다 (문서 단위 k=5: 93.0% -> 64.0%).
EMBEDDING_ADAPTER_PATH=adapters/embedding-hn-v1
EMBEDDING_MAX_SEQ_LENGTH=512

# --- 리랭킹 (검색 후보 재정렬) -----------------------------------------------
# ⚠️ GPU 가 아니면 켜지 마라. 후보 10건 재정렬에 GPU 0.5초 / CPU 8.5초다.
#   끄고 검색 limit 을 10 으로 두는 편이 낫다 — 문서 단위 k=10 이 97.2% 로
#   리랭커를 켠 k=5(96.3%)보다 오히려 높다.
#   리랭커가 사는 것은 정확도가 아니라 LLM 에 넘길 청크 수다(10개 -> 5개).
RERANK_ENABLED=false
RERANK_BASE_MODEL=dragonkue/bge-reranker-v2-m3-ko
# ⚠️ 범용 리랭커를 그대로 쓰면 검색이 나빠진다 (문서 단위 k=1: 66.4% -> 37.9%).
#   반드시 이 어댑터와 함께 쓸 것.
RERANK_ADAPTER_PATH=adapters/reranker-v1
RERANK_CANDIDATE_POOL=10

# 모델을 올릴 장치. 비우면 CUDA 가 있으면 CUDA, 없으면 CPU.
MODEL_DEVICE=
